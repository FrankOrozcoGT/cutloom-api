PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/cutloom

# Comma-separated list of allowed origins for CORS (frontend URLs).
# Defaults to http://localhost:5173 (cutloom-web's Vite dev server) if unset.
CORS_ORIGINS=http://localhost:5173

# JWT - must be at least 32 characters (256 bits) in production
JWT_SECRET=change-this-to-a-random-32-plus-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL — where /api/auth/google/callback redirects after login.
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 — server-side (confidential client) flow.
# Local dev may reuse an existing OAuth client, but production MUST use a
# dedicated client (own consent screen, own authorized redirect URIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Único dominio base del backend — todos los redirect_uri de OAuth (Google login,
# YouTube, TikTok) se construyen en código como ${API_BASE_URL}/path (ver
# authComposition.ts/publishingComposition.ts), nunca como variables sueltas por proveedor:
# evita que cambiar de ambiente (dev/túnel/prod) requiera actualizar varias env vars y queden
# desincronizadas entre sí. Cada path resultante debe registrarse tal cual (coincidencia exacta)
# en el portal de cada proveedor (Google Cloud Console / TikTok for Developers).
# TikTok exige HTTPS real (no localhost/HTTP) incluso en dev — usar un túnel público.
API_BASE_URL=http://localhost:3000

# Recurrente (pasarela de pagos) — docs.recurrente.com
RECURRENTE_API_KEY=sk_test_xxx
RECURRENTE_API_BASE_URL=https://app.recurrente.com/api
# Secreto del webhook (formato whsec_...) — usado para verificar la firma Svix del raw body.
PAYMENT_GATEWAY_WEBHOOK_SECRET=whsec_xxx

BILLING_DEFAULT_CURRENCY=GTQ

# Créditos de pago por uso: cuántos centavos de BILLING_DEFAULT_CURRENCY cuesta 1 unidad
# genérica de crédito (mismas unidades que plans.creditsPerCycle) — debe quedar más caro que el
# costo por crédito de cualquier plan (ver AuthorizeFeatureUsageUseCase: el plan se gasta
# primero, el crédito comprado aparte es el respaldo más caro).
CREDIT_TOPUP_RATE_CENTS_PER_UNIT=200

# Publishing — tabla única platform_oauth_tokens (YouTube + TikTok + cualquier plataforma
# futura). AES-256-GCM — debe tener exactamente 32 bytes en producción.
PLATFORM_OAUTH_ENCRYPTION_KEY=change-this-to-a-random-32-byte-secret

# Publishing — OAuth de YouTube (Google Cloud Console: habilitar YouTube Data API v3 en el
# mismo proyecto que GOOGLE_CLIENT_ID/SECRET). redirect_uri construido desde API_BASE_URL
# (/api/publishing/youtube/auth/callback) — distinto del de login porque el scope pedido es
# distinto (youtube.upload) — debe registrarse como authorized redirect URI aparte.

# Publishing — OAuth de TikTok (Login Kit v2 + Content Posting API — TikTok for Developers).
# Web es confidential-client, igual que YouTube: PKCE solo aplica a apps desktop/iOS/Android
# según la doc oficial, no a este flujo server-side. TikTok no permite localhost/HTTP como
# redirect_uri para apps web (confirmado contra la doc oficial) — API_BASE_URL debe ser un
# dominio público HTTPS real incluso en dev. redirect_uri construido
# (/api/publishing/tiktok/auth/callback) debe registrarse tal cual en el portal de TikTok for
# Developers (coincidencia exacta).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Secreto compartido para verificar la firma HMAC-SHA256 de los webhooks de TikTok (header
# TikTok-Signature) — mismo valor que TIKTOK_CLIENT_SECRET según la doc oficial de webhooks.
# TikTok no expone ningún endpoint de estado de auditoría de la app: cada subida intenta
# DIRECT_POST primero y cae automáticamente a MEDIA_UPLOAD (borrador) si TikTok la rechaza por
# no estar auditada — ver TikTokContentPostingUploader, no hace falta ninguna variable manual.

# Cloudflare R2 (S3-compatible) — almacena temporalmente el binario de shorts de TikTok
# calendarizados (TikTok no soporta scheduling nativo: el backend guarda el archivo y lo
# publica vía cron cuando llega publishAt, ver docs/tiktok-publishing-viability.md). El objeto
# se borra apenas se publica, así que el uso de storage esperado es mínimo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SCHEDULED_VIDEOS_BUCKET=cutloom-scheduled-videos
