PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/cutloom

# Comma-separated list of allowed origins for CORS (frontend URLs).
# Defaults to http://localhost:5173 (cutloom-web's Vite dev server) if unset.
CORS_ORIGINS=http://localhost:5173

# JWT - must be at least 32 characters (256 bits) in production
JWT_SECRET=change-this-to-a-random-32-plus-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL — where /api/auth/google/callback redirects after login.
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 — server-side (confidential client) flow.
# Local dev may reuse an existing OAuth client, but production MUST use a
# dedicated client (own consent screen, own authorized redirect URIs).
# GOOGLE_REDIRECT_URI must be registered as an authorized redirect URI in
# Google Cloud Console for this OAuth client — it must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# URL pública por la que la pasarela de pagos puede alcanzar este backend (túnel en dev,
# dominio real en producción) — usada para el puente checkout-return, no para el webhook.
API_BASE_URL=http://localhost:3000

# Recurrente (pasarela de pagos) — docs.recurrente.com
RECURRENTE_API_KEY=sk_test_xxx
RECURRENTE_API_BASE_URL=https://app.recurrente.com/api
# Secreto del webhook (formato whsec_...) — usado para verificar la firma Svix del raw body.
PAYMENT_GATEWAY_WEBHOOK_SECRET=whsec_xxx

BILLING_DEFAULT_CURRENCY=GTQ

# Publishing — OAuth de YouTube (Google Cloud Console: habilitar YouTube Data API v3 en el
# mismo proyecto que GOOGLE_CLIENT_ID/SECRET). redirect_uri distinto del login (/api/auth/google/callback)
# porque el scope pedido es distinto (youtube.upload) — debe registrarse como authorized redirect URI aparte.
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/publishing/youtube/auth/callback
# AES-256-GCM — debe tener exactamente 32 bytes en producción.
YOUTUBE_ENCRYPTION_KEY=change-this-to-a-random-32-byte-secret
